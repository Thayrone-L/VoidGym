<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Mono.Cecil">
      <HintPath>$(HollowKnightManaged)\Mono.Cecil.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateManagedPath" BeforeTargets="ResolveReferences">
    <Error Condition="'$(HollowKnightManaged)' == ''" Text="Set HollowKnightManaged." />
    <Error Condition="!Exists('$(HollowKnightManaged)\Mono.Cecil.dll')" Text="Mono.Cecil.dll was not found." />
  </Target>
</Project>
